# Copy this file to .env and replace values before a public deployment.
PORT=3000
NODE_ENV=development

# Persistent local SQLite database location
DATABASE_PATH=./data/store.sqlite

# Store identity and delivery settings (JMD)
STORE_NAME=Creator Hub Fashion
SHIPPING_FEE_JMD=500
FREE_SHIPPING_THRESHOLD_JMD=10000

# Optional PayPal checkout. Leave empty to keep PayPal disabled.
# Use sandbox credentials while testing, live credentials only for launch.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
# Required when item and checkout prices are shown in JMD but PayPal settles in USD.
# Set this from your own verified currency conversion policy; no rate is invented here.
JMD_PER_USD=

# Optional; restricts registration of admin roles to no one automatically.
# Create a customer account first, then use `npm run make-admin -- customer@example.com`.
